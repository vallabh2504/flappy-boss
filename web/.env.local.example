# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is git-ignored.

# Shared secret between ESP32 firmware and the API.
# Must match the API_KEY set in the ESP32 firmware AND in Vercel dashboard.
API_KEY=replace_with_a_long_random_string

# When running locally, leave this empty so fetch() calls go to localhost:3000.
# On Vercel, set this to your deployment URL, e.g. https://your-app.vercel.app
NEXT_PUBLIC_API_BASE_URL=
